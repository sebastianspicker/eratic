{
  "description": "Provider track identity parsed from a URL or a deck link (game-rules.md section 8.1), shared by Apple and web. `input` has `url` (providerTrack) or `link` (linkTrack: provider, url, optional id). `expected` is {provider, id, storefront?} or null; storefront appears only for Apple Music URLs.",
  "cases": [
    {
      "name": "spotify-uri",
      "input": {
        "url": "spotify:track:4uLU6hMCjMI75M1A2tKUQC"
      },
      "expected": {
        "provider": "spotify",
        "id": "4uLU6hMCjMI75M1A2tKUQC"
      }
    },
    {
      "name": "spotify-uri-wrong-length",
      "input": {
        "url": "spotify:track:4uLU6hMCjMI75M1A2tKUQCx"
      },
      "expected": null
    },
    {
      "name": "spotify-uri-short",
      "input": {
        "url": "spotify:track:uLU6hMCjMI75M1A2tKUQC"
      },
      "expected": null
    },
    {
      "name": "spotify-uri-album",
      "input": {
        "url": "spotify:album:4uLU6hMCjMI75M1A2tKUQC"
      },
      "expected": null
    },
    {
      "name": "spotify-uri-upper-case-scheme",
      "input": {
        "url": "SPOTIFY:track:4uLU6hMCjMI75M1A2tKUQC"
      },
      "expected": null
    },
    {
      "name": "spotify-url-with-query",
      "input": {
        "url": "https://open.spotify.com/track/4uLU6hMCjMI75M1A2tKUQC?si=abc123"
      },
      "expected": {
        "provider": "spotify",
        "id": "4uLU6hMCjMI75M1A2tKUQC"
      }
    },
    {
      "name": "spotify-url-plain",
      "input": {
        "url": "https://open.spotify.com/track/4uLU6hMCjMI75M1A2tKUQC"
      },
      "expected": {
        "provider": "spotify",
        "id": "4uLU6hMCjMI75M1A2tKUQC"
      }
    },
    {
      "name": "spotify-url-fragment",
      "input": {
        "url": "https://open.spotify.com/track/4uLU6hMCjMI75M1A2tKUQC#top"
