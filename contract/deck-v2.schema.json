{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qr-song-quiz.example/schema/deck-v2.json",
  "title": "QR Song Quiz deck version 2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}(?![\\s\\S])"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "\\S"
    },
    "defaultClipStartMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3600000
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}(?![\\s\\S])"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "\\S"
          },
          "artist": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "\\S"
          },
          "gameYear": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "value": {
                "type": "integer",
                "minimum": 1850,
                "maximum": 2100
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "\\S"
              },
              "note": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "\\S"
              }
            },
            "required": [
              "value",
              "source"
            ]
          },
          "recordingVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "\\S"
          },
          "isrc": {
            "type": "string",
            "pattern": "^[A-Z]{2}[A-Z0-9]{3}[0-9]{7}(?![\\s\\S])"
          },
          "links": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "provider": {
                  "enum": [
                    "spotify",
                    "appleMusic",
                    "youtube",
                    "other"
                  ]
                },
                "url": {
                  "type": "string",
                  "maxLength": 2048,
                  "pattern": "^https://[^\\s]+$"
                },
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "pattern": "\\S"
                },
                "releaseDate": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "pattern": "\\S"
                }
              },
              "required": [
                "provider",
                "url"
              ]
            }
          },
          "officialCard": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "url": {
                "type": "string",
                "maxLength": 2048,
                "pattern": "^https://[^\\s]+$"
              },
              "notes": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "\\S"
              }
            },
            "required": [
              "url"
            ]
          },
          "clip": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "startMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3600000
              }
            },
            "required": [
              "startMs"
            ]
          },
          "relatedTo": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "cardId": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}(?![\\s\\S])"
              },
              "relation": {
                "enum": [
                  "originalOf",
                  "coverOf",
                  "remasterOf"
                ]
              }
            },
            "required": [
              "cardId",
              "relation"
            ]
          },
          "difficulty": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        },
        "required": [
          "id",
          "title",
          "artist",
          "gameYear",
          "links"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "title",
    "cards"
  ]
}
